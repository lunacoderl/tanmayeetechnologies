# Tanmayee Technologies Platform — Environment Variables Example
# Copy this file to .env and configure for your environment

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Auth
JWT_SECRET=your-jwt-secret-min-32-chars-for-admin-and-api
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# API
PORT=4000
API_PORT=4000
API_URL=https://tanmayee-api.onrender.com
CORS_ORIGINS=https://tanmayeetechnologies.com,https://tanmayee-web.vercel.app,http://localhost:3000,http://localhost:3001

# Frontend (Public Next.js)
NEXT_PUBLIC_API_URL=https://tanmayee-api.onrender.com/api
NEXT_PUBLIC_SITE_URL=https://tanmayeetechnologies.com
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# WhatsApp & Regional Contacts
WHATSAPP_NUMBER=919390115553
CONTACT_PHONE=09390115553
